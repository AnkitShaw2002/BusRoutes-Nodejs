PORT=4000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/busroutes

# Generate independent random secrets; do not use the example values.
JWT_SECRET_KEY=
REFRESH_TOKEN_SECRET=
TICKET_SECRET=

# Set these only when bootstrapping the first administrator (npm run seed:admin).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Razorpay webhook secret is created in the Razorpay Dashboard webhook settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Stripe Checkout integration and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
FORCE_EMAIL_TO=

# Configure Redis URL or leave blank to use the local Redis default.
REDIS_URL=redis://127.0.0.1:6379
